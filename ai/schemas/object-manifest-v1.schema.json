{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksoloti.example/schemas/object-manifest-v1.schema.json",
  "title": "Ksoloti AI Object SDK manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stable_id", "id", "uuid", "description", "author",
    "license", "ports", "parameters", "implementation", "resources", "tests"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stable_id": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$"},
    "id": {"type": "string", "minLength": 1},
    "uuid": {"type": "string", "format": "uuid"},
    "description": {"type": "string"},
    "author": {"type": "string"},
    "license": {"type": "string", "minLength": 1},
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inlets", "outlets"],
      "properties": {
        "inlets": {"$ref": "#/$defs/ports"},
        "outlets": {"$ref": "#/$defs/ports"}
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "default"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$"},
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "type": {"type": "string"},
          "default": {"type": "string", "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)$"},
          "description": {"type": "string"}
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "class_name", "instance_name", "init_method", "process_method", "rate", "arguments"],
      "properties": {
        "header": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1},
        "instance_name": {"type": "string", "minLength": 1},
        "init_method": {"type": "string", "minLength": 1},
        "process_method": {"type": "string", "minLength": 1},
        "rate": {"enum": ["krate", "srate"]},
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_voices", "state_bytes", "scratch_bytes", "bounded_work_per_block"],
      "properties": {
        "max_voices": {"type": "integer", "minimum": 1},
        "state_bytes": {"type": "integer", "minimum": 0},
        "scratch_bytes": {"type": "integer", "minimum": 0},
        "bounded_work_per_block": {"type": "integer", "minimum": 0}
      }
    },
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "type": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
