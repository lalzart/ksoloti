<objdefs appVersion="1.1.0">
   <obj.normal id="drip-water" uuid="4fb3b79c-7687-5457-a168-10ad4a6a8069">
      <sDescription>Seeded three-resonator water-droplet physical model with triggered bursts or autonomous activity. Tags: physical-model, water, droplets, resonator, seedable, stereo-pair.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <bool32 name="trigger" description="start a short droplet burst"/>
         <frac32 name="activity" description="positive autonomous-density modulation"/>
      </inlets>
      <outlets>
         <frac32buffer name="output" description="left response"/>
         <frac32buffer name="aux" description="right response"/>
      </outlets>
      <params>
         <frac32.u.map name="activity"/>
         <frac32.u.map name="damping"/>
         <frac32.u.map name="brightness"/>
         <frac32.u.map name="spread"/>
         <int32 name="seed">
            <MinValue i="-2147483648"/>
            <MaxValue i="2147483647"/>
         </int32>
      </params>
      <attribs/>
      <includes>
         <include>./drip_water_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedDripWaterDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_trigger, inlet_activity, param_activity, param_damping, param_brightness, param_spread, param_seed, outlet_output, outlet_aux, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
