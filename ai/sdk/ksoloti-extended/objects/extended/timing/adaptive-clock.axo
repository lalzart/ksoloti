<objdefs appVersion="1.1.0">
   <obj.normal id="adaptive-clock" uuid="02290e30-4c43-5ad5-b324-42cb90576589">
      <sDescription>Tap-period tracker and predictive clock with smoothing and integer divide or multiply ratios. It coasts after irregular taps and drops lock after ten seconds. Tags: timing, tap-tempo, clock-predictor, irregular-clock, divider, multiplier.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <bool32 name="tap" description="measure interval on rising edge"/>
         <bool32 name="reset" description="clear lock"/>
      </inlets>
      <outlets>
         <bool32 name="clock" description="predicted one-block clock pulse"/>
         <frac32 name="phase" description="predicted ramp phase"/>
         <bool32 name="locked" description="two or more usable taps have been seen"/>
      </outlets>
      <params>
         <int32 name="ratio" description="negative divides, zero follows, positive multiplies">
            <MinValue i="-4"/>
            <MaxValue i="4"/>
         </int32>
         <frac32.u.map name="smoothing" description="period adaptation smoothing"/>
      </params>
      <attribs/>
      <includes>
         <include>./adaptive_clock_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedAdaptiveClockDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_tap, inlet_reset, param_ratio, param_smoothing, outlet_clock, outlet_phase, outlet_locked, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
