<objdefs appVersion="1.1.0">
   <obj.normal id="probability-router" uuid="f43d6cee-90ef-53a9-a8d3-b021d39794db">
      <sDescription>Seeded complementary probability router. A rising trigger produces a one-block pulse on exactly one output; probability 0 always selects B, probability 64 always selects A, and choice retains the last decision. Tags: random, Bernoulli, gate, complementary, deterministic, seedable.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <bool32 name="trigger" description="decision on rising edge"/>
      </inlets>
      <outlets>
         <bool32 name="a" description="selected-A one-block pulse"/>
         <bool32 name="b" description="selected-B one-block pulse"/>
         <bool32 name="choice" description="retained last decision; true is A"/>
      </outlets>
      <params>
         <frac32.u.map name="probability" description="probability of selecting A"/>
         <int32 name="seed" description="deterministic sequence seed">
            <MinValue i="-2147483648"/>
            <MaxValue i="2147483647"/>
         </int32>
      </params>
      <attribs/>
      <includes>
         <include>./probability_router_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedProbabilityRouterDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_trigger, param_probability, param_seed, outlet_a, outlet_b, outlet_choice);]]></code.krate>
   </obj.normal>
</objdefs>
