<objdefs appVersion="1.1.0">
   <obj.normal id="loop-mutate" uuid="50d2f060-3ad1-5b9f-9238-d52bffaf7b5f">
      <sDescription>Seeded 1-to-16-step random memory. On each rising clock, memory controls the probability of replaying the current slot: 0 produces fresh values, 64 locks a repeatable loop, and intermediate values make bounded mutations. Spread and bias reshape the stored loop without destroying it. Tags: random, loop, mutation, stepped-CV, deterministic, seedable, generative.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <bool32 name="clock" description="advance on rising edge"/>
         <bool32 name="reset" description="return to the first memory slot on rising edge"/>
      </inlets>
      <outlets>
         <frac32.bipolar name="value" description="current stored random value"/>
         <bool32 name="fresh" description="one-block pulse when a slot mutates"/>
         <int32 name="step" description="zero-based memory position"/>
      </outlets>
      <params>
         <frac32.u.map name="memory" description="probability of replaying rather than replacing a slot"/>
         <frac32.u.map name="spread" description="output range around the bias"/>
         <frac32.s.map name="bias" description="output offset"/>
         <int32 name="length" description="loop length">
            <MinValue i="1"/>
            <MaxValue i="16"/>
         </int32>
         <int32 name="seed" description="deterministic sequence seed">
            <MinValue i="-2147483648"/>
            <MaxValue i="2147483647"/>
         </int32>
      </params>
      <attribs/>
      <includes>
         <include>./loop_mutate_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedLoopMutateDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_clock, inlet_reset, param_memory, param_spread, param_bias, param_length, param_seed, outlet_value, outlet_fresh, outlet_step);]]></code.krate>
   </obj.normal>
</objdefs>
