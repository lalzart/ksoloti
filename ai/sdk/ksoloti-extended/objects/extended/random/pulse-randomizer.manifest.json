{
  "schema_version": 1,
  "stable_id": "com.lalzart.ksoloti.extended.random.pulse-randomizer",
  "id": "pulse-randomizer",
  "uuid": "15bb0609-6c76-59ac-80b0-767c4b587fb7",
  "description": "Seeded clock pulse randomizer with probability, variable width, and width variation. Each input edge also captures a repeatable random value. Tags: random, pulse, clock, probability, seedable, deterministic.",
  "author": "Lance Ship",
  "license": "GPL-3.0-or-later",
  "ports": {"inlets": [{"name": "clock", "type": "bool32", "description": "make a decision on each rising edge"}, {"name": "reset", "type": "bool32", "description": "restart the seeded sequence"}], "outlets": [{"name": "pulse", "type": "bool32", "description": "randomized gate"}, {"name": "value", "type": "frac32", "description": "random value retained between clock edges"}]},
  "parameters": [
    {"id": "com.lalzart.ksoloti.extended.random.pulse-randomizer.probability", "name": "probability", "type": "frac32.u.map", "default": "40"},
    {"id": "com.lalzart.ksoloti.extended.random.pulse-randomizer.width", "name": "width", "type": "frac32.u.map", "default": "4"},
    {"id": "com.lalzart.ksoloti.extended.random.pulse-randomizer.variation", "name": "variation", "type": "frac32.u.map", "default": "12"},
    {"id": "com.lalzart.ksoloti.extended.random.pulse-randomizer.seed", "name": "seed", "type": "int32", "default": "1", "minimum": -2147483648, "maximum": 2147483647}
  ],
  "implementation": {"header": "pulse_randomizer_dsp.h", "class_name": "KsolotiExtendedPulseRandomizerDSP", "instance_name": "engine", "init_method": "Init", "process_method": "Process", "rate": "krate", "arguments": ["inlet_clock", "inlet_reset", "param_probability", "param_width", "param_variation", "param_seed", "outlet_pulse", "outlet_value"]},
  "resources": {"max_voices": 1, "state_bytes": 20, "scratch_bytes": 0, "bounded_work_per_block": 64},
  "compatibility": {"tier": "core", "build_status": "offline-verified", "tested_targets": ["host-c++17", "ksoloti-core@1.1.0"], "notes": "Portable tests and the combined control-scenes Cortex-M4 link passed."},
  "tests": ["edge-only-decision", "seed-repeatability", "probability-extremes", "width-bound"]
}
