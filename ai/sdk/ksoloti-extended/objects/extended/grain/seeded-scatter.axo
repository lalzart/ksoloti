<objdefs appVersion="1.1.0">
   <obj.normal id="seeded-scatter" uuid="8b5388f2-b4ee-58fd-b339-c73920b45b71">
      <sDescription>Four-voice seeded granular scatter over a fixed recent-audio buffer, with manual or density-driven grain creation, pitch, spread, and bounded feedback. Tags: grain, scatter, seeded, stereo, delay-buffer, external-audio, heavy.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <frac32buffer.bipolar name="input" description="audio written into the recent-history buffer"/>
         <bool32 name="trigger" description="spawn a grain on rising edge"/>
      </inlets>
      <outlets>
         <frac32buffer.bipolar name="left" description="left grain mix"/>
         <frac32buffer.bipolar name="right" description="right grain mix"/>
      </outlets>
      <params>
         <frac32.u.map name="density"/>
         <frac32.u.map name="size"/>
         <frac32.u.map name="pitch"/>
         <frac32.u.map name="spread"/>
         <frac32.u.map name="feedback"/>
         <int32 name="seed">
            <MinValue i="-2147483648"/>
            <MaxValue i="2147483647"/>
         </int32>
      </params>
      <attribs/>
      <includes>
         <include>./seeded_scatter_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedSeededScatterDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_input, inlet_trigger, param_density, param_size, param_pitch, param_spread, param_feedback, param_seed, outlet_left, outlet_right, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
