<objdefs appVersion="1.1.0">
   <obj.normal id="pitch-amdf" uuid="b4facf5c-dc19-5ebe-a4a8-d4cf874592bc">
      <sDescription>Monophonic average-magnitude-difference pitch and level tracker for external audio. It reports native Ksoloti pitch, smoothed mean-absolute level, AMDF confidence, and an explicit validity gate while retaining the last accepted pitch. Tags: analysis, pitch, AMDF, level, confidence, external-audio, monophonic.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <frac32buffer.bipolar name="input" description="monophonic periodic audio"/>
      </inlets>
      <outlets>
         <frac32.bipolar name="pitch" description="last accepted Ksoloti pitch; E4 is zero"/>
         <frac32 name="level" description="smoothed mean absolute input level"/>
         <frac32 name="confidence" description="normalized AMDF clarity"/>
         <bool32 name="valid" description="level and confidence both pass their thresholds"/>
      </outlets>
      <params>
         <int32 name="minimum_frequency" description="lowest tracked frequency in hertz">
            <MinValue i="40"/>
            <MaxValue i="200"/>
         </int32>
         <int32 name="maximum_frequency" description="highest tracked frequency in hertz">
            <MinValue i="400"/>
            <MaxValue i="2000"/>
         </int32>
         <frac32.u.map name="threshold" description="minimum mean-absolute level"/>
         <frac32.u.map name="quality" description="minimum AMDF confidence"/>
         <frac32.u.map name="smooth" description="accepted-pitch smoothing"/>
      </params>
      <attribs/>
      <includes>
         <include>./pitch_amdf_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedPitchAMDFAudioDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_input, param_minimum__frequency, param_maximum__frequency, param_threshold, param_quality, param_smooth, outlet_pitch, outlet_level, outlet_confidence, outlet_valid, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
