<objdefs appVersion="1.1.0">
   <obj.normal id="comb-network" uuid="9d6f002b-813b-5bc1-8502-02fc3b08e2e2">
      <sDescription>Four nested, cross-coupled feedback comb lines with damping and stereo decorrelation. Tags: effect, comb, feedback-network, resonator, spatial, stereo, heavy.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <frac32buffer.bipolar name="input" description="mono excitation"/>
      </inlets>
      <outlets>
         <frac32buffer.bipolar name="left" description="left network output"/>
         <frac32buffer.bipolar name="right" description="right network output"/>
      </outlets>
      <params>
         <frac32.u.map name="size"/>
         <frac32.u.map name="feedback"/>
         <frac32.u.map name="damping"/>
         <frac32.u.map name="spread"/>
         <frac32.u.map name="mix"/>
      </params>
      <attribs/>
      <includes>
         <include>./comb_network_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedCombNetworkDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_input, param_size, param_feedback, param_damping, param_spread, param_mix, outlet_left, outlet_right, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
