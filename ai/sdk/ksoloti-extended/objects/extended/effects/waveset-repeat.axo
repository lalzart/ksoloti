<objdefs appVersion="1.1.0">
   <obj.normal id="waveset-repeat" uuid="40a47278-7d5a-5db2-9ff3-4fbd7e0bc3b5">
      <sDescription>Captures one to sixteen pairs of thresholded zero crossings and repeats that waveset a bounded number of times. Tags: effect, waveset, zero-crossing, repeat, glitch, audio-buffer.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <frac32buffer.bipolar name="input" description="audio to capture"/>
         <bool32 name="trigger" description="begin capture on rising edge"/>
      </inlets>
      <outlets>
         <frac32buffer.bipolar name="output" description="dry/repeated mix"/>
         <bool32 name="capturing" description="capture state"/>
         <bool32 name="repeating" description="playback state"/>
      </outlets>
      <params>
         <int32 name="cycles">
            <MinValue i="1"/>
            <MaxValue i="16"/>
         </int32>
         <int32 name="repeats">
            <MinValue i="1"/>
            <MaxValue i="32"/>
         </int32>
         <frac32.u.map name="threshold"/>
         <frac32.u.map name="mix"/>
      </params>
      <attribs/>
      <includes>
         <include>./waveset_repeat_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedWavesetRepeatDSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_input, inlet_trigger, param_cycles, param_repeats, param_threshold, param_mix, outlet_output, outlet_capturing, outlet_repeating, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
