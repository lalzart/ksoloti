<objdefs appVersion="1.1.0">
   <obj.normal id="segment-6" uuid="4cd1a718-f99c-505a-9f4a-5b86f2d8d0e5">
      <sDescription>Six chained ramp segments for envelopes, looping modulation, stepped sequences, and held stages. Each segment has an independent target and duration. Tags: modulation, envelope, function-generator, sequencer, slew, loopable.</sDescription>
      <author>Lance Ship</author>
      <license>GPL-3.0-or-later</license>
      <inlets>
         <bool32 name="trigger" description="restart segment one on a rising edge"/>
         <bool32 name="gate" description="hold at the selected sustain segment"/>
         <frac32 name="rate" description="global positive speed modulation"/>
      </inlets>
      <outlets>
         <frac32 name="output" description="current segment value"/>
         <bool32 name="eoc" description="one-block end-of-chain pulse"/>
         <int32 name="segment" description="active zero-based segment"/>
      </outlets>
      <params>
         <frac32.u.map name="level1"/>
         <frac32.u.map name="level2"/>
         <frac32.u.map name="level3"/>
         <frac32.u.map name="level4"/>
         <frac32.u.map name="level5"/>
         <frac32.u.map name="level6"/>
         <frac32.u.map name="time1"/>
         <frac32.u.map name="time2"/>
         <frac32.u.map name="time3"/>
         <frac32.u.map name="time4"/>
         <frac32.u.map name="time5"/>
         <frac32.u.map name="time6"/>
         <frac32.u.map name="shape" description="linear through smooth to stepped"/>
         <int32 name="sustain" description="segment held while gate is high">
            <MinValue i="0"/>
            <MaxValue i="5"/>
         </int32>
         <bool32.tgl name="loop" description="restart after segment six"/>
      </params>
      <attribs/>
      <includes>
         <include>./segment_6_dsp.h</include>
      </includes>
      <code.declaration><![CDATA[KsolotiExtendedSegment6DSP engine;]]></code.declaration>
      <code.init><![CDATA[engine.Init();]]></code.init>
      <code.krate><![CDATA[engine.Process(inlet_trigger, inlet_gate, inlet_rate, param_level1, param_level2, param_level3, param_level4, param_level5, param_level6, param_time1, param_time2, param_time3, param_time4, param_time5, param_time6, param_shape, param_sustain, param_loop, outlet_output, outlet_eoc, outlet_segment, BUFSIZE);]]></code.krate>
   </obj.normal>
</objdefs>
